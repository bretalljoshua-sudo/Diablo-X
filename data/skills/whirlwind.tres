&"move_factor": 0.6,
&"tick_interval": 0.25,
&"upgrade_resource_max_targets": 3.0,
&"upgrade_resource_per_hit": 1.0
})
upgrade_name = "Verbesserter Wirbelsturm"
upgrade_description = "Jeder getroffene Gegner gibt pro Takt 1 Wut zurück (höchstens 3 Gegner)."
